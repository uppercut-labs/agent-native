{
  "name": "@uppercut-labs/agent-native",
  "version": "0.1.1",
  "license": "MIT",
  "description": "Experimental typed capability contracts with local, HTTP, CLI, and MCP adapters.",
  "repository": {
    "type": "git",
    "url": "https://github.com/uppercut-labs/agent-native.git"
  },
  "bugs": {
    "url": "https://github.com/uppercut-labs/agent-native/issues"
  },
  "homepage": "https://github.com/uppercut-labs/agent-native#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "docs"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./contracts": {
      "types": "./dist/core/contracts.d.ts",
      "import": "./dist/core/contracts.js"
    },
    "./harness": {
      "types": "./dist/harness.d.ts",
      "import": "./dist/harness.js"
    },
    "./composition": {
      "types": "./dist/core/composition.d.ts",
      "import": "./dist/core/composition.js"
    },
    "./registry": {
      "types": "./dist/registry.d.ts",
      "import": "./dist/registry.js"
    },
    "./executor": {
      "types": "./dist/core/executor.d.ts",
      "import": "./dist/core/executor.js"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.js"
    },
    "./http": {
      "types": "./dist/http.d.ts",
      "import": "./dist/http.js"
    },
    "./schema/zod": {
      "types": "./dist/adapters/zod.d.ts",
      "import": "./dist/adapters/zod.js"
    },
    "./diagnostics": {
      "types": "./dist/core/diagnostics.d.ts",
      "import": "./dist/core/diagnostics.js"
    },
    "./doctor": {
      "types": "./dist/doctor.d.ts",
      "import": "./dist/doctor.js"
    },
    "./mcp": {
      "types": "./dist/mcp.d.ts",
      "import": "./dist/mcp.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js"
    },
    "./astro": {
      "types": "./dist/astro.d.ts",
      "import": "./dist/astro.js"
    },
    "./next": {
      "types": "./dist/next.d.ts",
      "import": "./dist/next.js"
    },
    "./next/browser": {
      "types": "./dist/next-browser.d.ts",
      "import": "./dist/next-browser.js"
    },
    "./init": {
      "types": "./dist/init.d.ts",
      "import": "./dist/init.js"
    },
    "./auth": {
      "types": "./dist/auth.d.ts",
      "import": "./dist/auth.js"
    },
    "./mcp-apps": {
      "types": "./dist/mcp-apps.d.ts",
      "import": "./dist/mcp-apps.js"
    },
    "./harness/mcp-bridge": {
      "types": "./dist/harness-mcp-bridge.d.ts",
      "import": "./dist/harness-mcp-bridge.js"
    },
    "./harness/codex": {
      "types": "./dist/harness-codex.d.ts",
      "import": "./dist/harness-codex.js"
    }
  },
  "scripts": {
    "format": "biome format --write .",
    "format:check": "biome format .",
    "pretypecheck": "node scripts/check-package-version.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.browser.json && tsc --noEmit -p tsconfig.sdk-proof.json",
    "lint": "biome lint .",
    "test": "npm run build && npm run build:test-fixtures && node --test test/*.test.mjs",
    "build:test-fixtures": "tsc -p tsconfig.sdk-proof.json --noEmit false",
    "prebuild": "node scripts/check-package-version.mjs",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "build:browser-proof": "tsc -p tsconfig.browser-proof.json",
    "example:e01": "node scripts/check-e01-baseline.mjs && node scripts/check-example.mjs e01-album-catalog",
    "example:e02": "node scripts/check-example.mjs e02-astro-on-demand-catalog",
    "example:e12": "node scripts/check-example.mjs e12-shared-unit-converter",
    "example:e08": "node scripts/check-example.mjs e08-reusable-versioned-pack",
    "example:e10": "node scripts/check-example.mjs e10-existing-functions-retrofit",
    "example:e05": "node scripts/check-example.mjs e05-node-cli",
    "example:e06": "node scripts/check-example.mjs e06-browser-only-theme-controls",
    "example:e03": "node scripts/check-example.mjs e03-next-reading-list",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run build:browser-proof && npm test && npm run example:e01 && npm run example:e02 && npm run example:e03 && npm run example:e08 && npm run example:e10 && npm run example:e12 && npm run example:e05 && npm run example:e06 && npm run example:e04 && npm run example:e07 && npm run example:e09 && npm run example:e11 && npm run docs:check && npm run check:portability",
    "example:e04": "node scripts/check-example.mjs e04-worker-sidecar",
    "example:e07": "node scripts/check-example.mjs e07-playlist-permissions",
    "example:e09": "node scripts/check-example.mjs e09-album-explorer",
    "example:e11": "node scripts/check-example.mjs e11-diagnostics-fault-lab",
    "docs:build": "node docs-site/build.mjs",
    "docs:check": "node --test docs-site/coverage-check.test.mjs docs-site/source-regions.test.mjs docs-site/reference.test.mjs && npm run docs:build && node docs-site/check.mjs",
    "check:portability": "node scripts/check-package-portability.mjs",
    "proof:codex": "npm run build && node scripts/check-codex-harness.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@modelcontextprotocol/client": "2.3.0",
    "@modelcontextprotocol/ext-apps": "2.0.3",
    "@modelcontextprotocol/server": "2.3.0",
    "@types/node": "22.20.5",
    "ajv": "8.20.0",
    "astro": "7.3.5",
    "marked": "18.0.14",
    "typescript": "7.0.2",
    "zod": "4.6.5"
  },
  "peerDependencies": {
    "@modelcontextprotocol/ext-apps": "2.0.3",
    "@modelcontextprotocol/server": "2.3.0",
    "astro": ">=7.0.0 <8.0.0",
    "zod": "4.6.5"
  },
  "peerDependenciesMeta": {
    "@modelcontextprotocol/ext-apps": {
      "optional": true
    },
    "@modelcontextprotocol/server": {
      "optional": true
    },
    "astro": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  }
}
