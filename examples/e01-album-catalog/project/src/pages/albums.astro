---
import SiteLayout from '../layouts/SiteLayout.astro';
import { CATALOG_REVISION, publicAlbums } from '../catalog-contract.mjs';
---
<SiteLayout title="Albums">
  <section data-album-catalog data-catalog-revision={CATALOG_REVISION} data-sidecar-origin={import.meta.env.PUBLIC_AGENT_NATIVE_SIDECAR_ORIGIN ?? ''} data-route-mode={import.meta.env.PUBLIC_AGENT_NATIVE_ROUTE_MODE ?? 'sidecar'}>
    <p class="eyebrow">Catalog</p>
    <h1>Albums</h1>
    <p data-sidecar-status aria-live="polite">Static catalog revision: {CATALOG_REVISION}. Sidecar is not configured.</p>
    <p data-agent-status aria-live="polite">The catalog works with or without browser agent support.</p>
    <form data-album-lookup data-astro-reload>
      <label for="album-slug">Find an album by slug</label>
      <input id="album-slug" name="slug" pattern="[a-z0-9]+(-[a-z0-9]+)*" required />
      <button type="submit">Find album</button>
      <output data-lookup-result aria-live="polite"></output>
    </form>
    <ul class="album-list">
      {publicAlbums.map((album) => <li><a href={`#${album.slug}`}>{album.title}</a><code id={album.slug}>{album.slug}</code></li>)}
    </ul>
  </section>
</SiteLayout>
