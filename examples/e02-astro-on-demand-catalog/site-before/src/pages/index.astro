---
import SiteLayout from '../layouts/SiteLayout.astro';
---

<SiteLayout title="Index">
  <section class="lead">
    <p class="kicker">Three records / one shelf</p>
    <h1>Music worth finding twice.</h1>
    <div class="lead-notes">
      <p>A hand-kept index of records for late routes, wet windows, and the long way home.</p>
      <a class="text-link" href="/albums/">Open the catalog <span aria-hidden="true">-&gt;</span></a>
    </div>
  </section>
  <aside class="shelf-note" aria-label="Catalog note">
    <span>Current file</span>
    <strong>03 albums</strong>
    <span>1978-1996</span>
  </aside>
</SiteLayout>
