{
  "compilerOptions": {
    "target": "ES2022",
    "module": "preserve",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "dom"],
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "experimentalDecorators": true,
    "isolatedModules": true,
    "types": []
  },
  "angularCompilerOptions": { "strictTemplates": true },
  "files": ["src/main.ts", "src/main.server.ts"]
}
