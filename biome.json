{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "files": {
    "includes": [
      "**",
      "!dist",
      "!docs-site/dist",
      "!.test-dist",
      "!test/fixtures/a2ui-v1_0",
      "!docs/ui/a2ui-catalog.json",
      "!examples/e01-album-catalog/.exported",
      "!examples/e02-astro-on-demand-catalog/.exported",
      "!examples/e02-astro-on-demand-catalog/site-before",
      "!examples/e12-shared-unit-converter/.exported",
      "!examples/e05-node-cli/.exported",
      "!examples/e06-browser-only-theme-controls/.exported",
      "!examples/e03-next-reading-list/.exported",
      "!examples/e08-reusable-versioned-pack/.exported",
      "!examples/e03-next-reading-list/site-before",
      "!examples/e04-worker-sidecar/.exported",
      "!examples/e07-playlist-permissions/.exported",
      "!examples/e11-diagnostics-fault-lab/.exported",
      "!examples/e09-album-explorer/.exported",
      "!examples/e13-ui-patterns/.exported",
      "!examples/e13-ui-patterns/project/dist",
      "!examples/readability/**/.next",
      "!examples/readability/**/.nuxt",
      "!examples/readability/**/.output",
      "!examples/readability/**/.astro",
      "!examples/readability/**/.angular",
      "!examples/readability/**/.svelte-kit",
      "!examples/readability/**/.react-router",
      "!examples/readability/**/dist",
      "!examples/readability/**/build",
      "!examples/readability/**/generated",
      "!examples/readability/**/public/agent-native-witness.json",
      "!examples/readability/**/static/agent-native-witness.json",
      "!examples/readability/**/.publication-state"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf"
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "useConst": "off"
      },
      "complexity": {
        "useLiteralKeys": "off"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always"
    }
  }
}
