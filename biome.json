{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "files": {
    "includes": [
      "**",
      "!dist",
      "!.test-dist",
      "!examples/e01-album-catalog/.exported",
      "!examples/e02-astro-on-demand-catalog/.exported",
      "!examples/e02-astro-on-demand-catalog/site-before",
      "!examples/e12-shared-unit-converter/.exported",
      "!examples/e05-node-cli/.exported",
      "!examples/e06-browser-only-theme-controls/.exported",
      "!examples/e03-next-reading-list/.exported",
      "!examples/e08-reusable-versioned-pack/.exported",
      "!examples/e03-next-reading-list/site-before",
      "!examples/e04-worker-sidecar/.exported",
      "!examples/e09-album-explorer/.exported"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf"
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always"
    }
  }
}
